---
import Layout from '../../layouts/PageLayout.astro';
import Headline from '../../components/blog/Headline.astro';
import { getAvailableSessions, getSessionDisplayName, CURRENT_SESSION } from '../../utils/numsa';

export const prerender = true;

const sessions = getAvailableSessions();
const currentSession = CURRENT_SESSION;

const metadata = {
  title: 'NUMSA Administration Archive',
  description: 'Browse past NUMSA administrations and their accomplishments',
  robots: {
    index: true,
    follow: true,
  },
};
---

<Layout metadata={metadata}>
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <Headline subtitle="Explore the history of NUMSA leadership and their achievements">
      Administration Archive
    </Headline>

    <div class="grid gap-8 md:grid-cols-2 mt-12">
      {sessions.reverse().map((session) => {
        const isCurrent = session === currentSession;
        return (
          <div class={`bg-white dark:bg-gray-800 border-2 rounded-xl shadow-sm hover:shadow-lg transition-all duration-300 overflow-hidden ${isCurrent ? 'border-blue-500 dark:border-blue-400' : 'border-gray-200 dark:border-gray-700'}`}>
            <div class="p-6">
              <div class="flex items-center justify-between mb-4">
                <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
                  {getSessionDisplayName(session)}
                </h2>
                {isCurrent && (
                  <span class="px-3 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 text-xs font-semibold rounded-full">
                    Current
                  </span>
                )}
              </div>
              <p class="text-gray-600 dark:text-gray-400 mb-6">
                {isCurrent
                  ? 'View the current administration and their leadership.'
                  : 'Explore the achievements and leadership of this past session.'}
              </p>

              <div class="space-y-3">
                <a
                  href={isCurrent ? '/excos' : `/${session}/excos`}
                  class="block px-4 py-3 bg-blue-50 dark:bg-blue-900/20 hover:bg-blue-100 dark:hover:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-lg transition-colors duration-200 text-center font-medium"
                >
                  Executive Council
                </a>

                <a
                  href={isCurrent ? '/house' : `/${session}/house`}
                  class="block px-4 py-3 bg-blue-50 dark:bg-blue-900/20 hover:bg-blue-100 dark:hover:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-lg transition-colors duration-200 text-center font-medium"
                >
                  The House
                </a>

                <a
                  href={isCurrent ? '/jc' : `/${session}/jc`}
                  class="block px-4 py-3 bg-blue-50 dark:bg-blue-900/20 hover:bg-blue-100 dark:hover:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-lg transition-colors duration-200 text-center font-medium"
                >
                  Legislative Commission
                </a>
              </div>
            </div>

            <div class={`px-6 py-4 border-t ${isCurrent ? 'bg-blue-50 dark:bg-blue-900/10 border-blue-200 dark:border-blue-700' : 'bg-gray-50 dark:bg-gray-900/50 border-gray-200 dark:border-gray-700'}`}>
              <p class="text-sm font-medium text-center" class:list={[
                isCurrent ? 'text-blue-700 dark:text-blue-300' : 'text-gray-500 dark:text-gray-400'
              ]}>
                {isCurrent ? '✨ Active Administration' : '📚 Archived Session'}
              </p>
            </div>
          </div>
        );
      })}
    </div>

    <div class="mt-12 text-center">
      <a
        href="/"
        class="inline-flex items-center px-6 py-3 bg-primary hover:bg-primary/90 text-white rounded-lg transition-colors duration-200 font-medium"
      >
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Home
      </a>
    </div>
  </section>
</Layout>

