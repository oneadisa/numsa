---
import Layout from '../../layouts/PageLayout.astro';
import ContentList from '../../components/numsa/ContentList.astro';
import Headline from '../../components/blog/Headline.astro';
import { blogListRobots } from '../../utils/blog';
import { getCollection } from 'astro:content';
import { formatContent, getSessionDisplayName } from '../../utils/numsa';

export const prerender = true;

// Get ALL outreaches from all administrations
const allPosts = await getCollection('outreaches');
const formattedPosts = formatContent(allPosts, 'outreaches');

// Get unique sessions for filtering
const availableSessions = [...new Set(allPosts.map(p => p.data.session).filter(Boolean))].sort().reverse();

const metadata = {
  title: 'Outreaches - All Administrations',
  robots: { 
    index: blogListRobots?.index,
    follow: blogListRobots?.follow,
  },
  openGraph: {
    type: 'numsa',
  },
};
---

<Layout metadata={metadata}>
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <Headline
      subtitle="A collection of all outreaches by NUMSA across all administrations"
    >
      NUMSA Outreaches
    </Headline>

    <!-- Session Filter -->
    {availableSessions.length > 1 && (
      <div class="mb-8 flex items-center gap-3 justify-center">
        <label for="session-filter" class="text-sm font-medium text-gray-700 dark:text-gray-300">Filter by:</label>
        <select 
          id="session-filter"
          class="px-4 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 font-medium cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400"
        >
          <option value="all">All Administrations</option>
          {availableSessions.map(session => (
            <option value={session || ''}>{getSessionDisplayName(session || '')}</option>
          ))}
        </select>
      </div>
    )}

    <div id="outreaches-container">
      <ContentList items={formattedPosts} contentType="outreaches" />
    </div>
  </section>
</Layout>

<script is:inline>
  (function() {
    function initFilter() {
      const filterSelect = document.getElementById('session-filter');
      if (!filterSelect || filterSelect.tagName !== 'SELECT') {
        setTimeout(initFilter, 100);
        return;
      }

      const container = document.getElementById('outreaches-container');
      if (!container) {
        setTimeout(initFilter, 100);
        return;
      }

      function filterOutreaches(selectedSession) {
        // Query items fresh each time to ensure we get all items
        const outreachItems = container.querySelectorAll('li[data-session]');
        
        if (outreachItems.length === 0) {
          // If no items found, retry after a short delay
          setTimeout(function() {
            filterOutreaches(selectedSession);
          }, 100);
          return;
        }

        outreachItems.forEach(function(item) {
          const itemSession = item.getAttribute('data-session') || '';
          
          if (selectedSession === 'all' || itemSession === selectedSession) {
            item.style.display = '';
            item.classList.remove('hidden');
          } else {
            item.style.display = 'none';
            item.classList.add('hidden');
          }
        });
      }

      // Add event listener to select dropdown
      filterSelect.addEventListener('change', function() {
        const selectedSession = this.value || 'all';
        filterOutreaches(selectedSession);
      });

      // Initialize with 'all' selected after a short delay to ensure DOM is ready
      setTimeout(function() {
        filterOutreaches('all');
      }, 100);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFilter);
    } else {
      initFilter();
    }
  })();
</script>
