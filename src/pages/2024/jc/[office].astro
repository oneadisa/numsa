---
import type { GetStaticPaths } from 'astro';

export const prerender = true;

export const getStaticPaths = (async () => {
  const allModules = import.meta.glob('/src/content/sessions/*/jc/*.yaml');

  const sessionFiles = Object.keys(allModules).filter((path) =>
    path.includes(`/sessions/2023-24/jc/`)
  );

  const paths = sessionFiles.map((path) => ({
    params: {
      office: path.split('/').pop()?.replace('.yaml', '') || ''
    },
  }));

  return paths;
}) satisfies GetStaticPaths;

const { office } = Astro.params;

return Astro.redirect(`/2023-24/jc/${office}`, 301);
---
