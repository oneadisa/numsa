---
import type { GetStaticPaths } from 'astro';

export const prerender = true;

export const getStaticPaths = (async () => {
  const allModules = import.meta.glob('/src/content/sessions/*/house/*.json', { eager: true });

  const sessionModules = Object.entries(allModules).filter(([path]) =>
    path.includes(`/sessions/2023-24/house/`)
  );

  const paths = sessionModules.map(([path]) => ({
    params: {
      office: path.split('/').pop()?.replace('.json', '') || ''
    },
  }));

  return paths;
}) satisfies GetStaticPaths;

const { office } = Astro.params;

return Astro.redirect(`/2023-24/house/${office}`, 301);
---
