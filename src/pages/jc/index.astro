---
/**
 * Root-level Legislative Commission page - shows ALL JC members from ALL sessions
 */
import Layout from '../../layouts/PageLayout.astro';
import ContentList from '../../components/numsa/ContentList.astro';
import Headline from '../../components/blog/Headline.astro';
import { blogListRobots } from '../../utils/blog';
import { formatContent } from '../../utils/numsa';

export const prerender = true;

// Get ALL JC members from ALL sessions using static glob pattern
// Converted YAML files to JSON for consistency with excos/house
const allModules = import.meta.glob('/src/content/sessions/*/jc/*.json', { eager: true, import: 'default' });

// Map all JC members with their session information
const allJC = Object.entries(allModules).map(([path, data]) => {
  // Extract session from path: /src/content/sessions/2023-24/jc/chairlady.json
  const sessionMatch = path.match(/\/sessions\/([^/]+)\//);
  const session = sessionMatch ? sessionMatch[1] : '';

  return {
    id: path.split('/').pop()?.replace('.json', '') || '',
    slug: path.split('/').pop()?.replace('.json', '') || '',
    data: data as any,
    session: session, // Include session info for display
  };
});

// Format all posts without session filtering
const formattedPosts = formatContent(allJC, 'jc');

const metadata = {
  title: 'Legislative Commission - All Administrations',
  robots: {
    index: blogListRobots?.index,
    follow: blogListRobots?.follow,
  },
  openGraph: {
    type: 'numsa',
  },
};
---

<Layout metadata={metadata}>
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <Headline subtitle="Meet all legislative commission members across all administrations">
      Legislative Commission
    </Headline>
    <ContentList items={formattedPosts} contentType="jc" />
  </section>
</Layout>
