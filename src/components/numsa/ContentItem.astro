---
import type { ContentItem } from '../../types/numsa';
import { Icon } from 'astro-icon/components';
import Image from '../common/Image.astro';
import { findImage } from '../../utils/images';
import type { ImageMetadata } from 'astro';

export interface Props {
  item: ContentItem;
  contentType: string;
  layout?: 'grid' | 'list' | 'cards';
}

const { item, contentType, layout = 'grid' } = Astro.props;

// Determine if this is an excos/house/jc card
const isExcosType = contentType === 'excos' || contentType === 'senators' || contentType === 'jc' || contentType === 'house';

// Get the appropriate image for the item
const imageSrc = item.image || item.mainImage;
let image: ImageMetadata | string | undefined = undefined;

// For excos/house/jc, use default avatar if no image specified
if (isExcosType) {
  if (!imageSrc || imageSrc.trim() === '') {
    // No image source provided - use default avatar
    image = '/assets/images/default_avatar.jpg';
  } else {
    // Try to find the image
    const foundImage = await findImage(imageSrc) as ImageMetadata | string | undefined | null;

    if (!foundImage || foundImage === null) {
      // Image not found - use default avatar
      image = '/assets/images/default_avatar.jpg';
    } else {
      // Use the found image
      image = foundImage;
    }
  }
} else {
  // For non-excos types, use findImage normally
  image = imageSrc ? await findImage(imageSrc) as ImageMetadata | string | undefined : undefined;
}

// Determine if we should show image based on layout and content type
const showImage = image && (layout === 'grid' || layout === 'cards' || contentType === 'campaigns' || contentType === 'outreaches' || isExcosType);

// Get appropriate title
const displayTitle = item.title || item.position || 'Untitled';

// Determine if this is a clickable item
const isClickable = item.link && item.link !== '#';

// Get appropriate excerpt
// For excos, don't show excerpt in cards since bio is shown on detail page
const isExcosCard = isExcosType;
const displayExcerpt = isExcosCard ? '' : (item.excerpt || item.caption || item.bio || '');

// Use portrait aspect ratio for excos/house/jc (to show full faces), landscape for others
// Using 4:5 ratio (less extreme than 3:4) to reduce blank space while still showing faces
const imageAspectRatio = isExcosCard ? '4:5' : '16:9';
const imageHeight = isExcosCard ? (layout === 'cards' ? 500 : 800) : (layout === 'cards' ? 300 : 600);
---

<article class={`content-item layout-${layout} ${isClickable ? 'clickable' : ''}`} data-session={item.session || ''}>
  {showImage && (
    <div class="image-container">
      {isClickable ? (
        <a href={item.link} class="image-link group">
          <div class={`image-wrapper ${isExcosCard ? 'portrait' : 'landscape'}`}>
            <Image
              src={image}
              class="content-image"
              width={layout === 'cards' ? 400 : 900}
              height={imageHeight}
              sizes={layout === 'cards' ? '400px' : '(max-width: 900px) 400px, 900px'}
              alt={displayTitle}
              aspectRatio={imageAspectRatio}
              loading="lazy"
              decoding="async"
            />
          </div>
        </a>
      ) : (
        <div class={`image-wrapper ${isExcosCard ? 'portrait' : 'landscape'}`}>
          <Image
            src={image}
            class="content-image"
            width={layout === 'cards' ? 400 : 900}
            height={imageHeight}
            sizes={layout === 'cards' ? '400px' : '(max-width: 900px) 400px, 900px'}
            alt={displayTitle}
            aspectRatio={imageAspectRatio}
            loading="lazy"
            decoding="async"
          />
        </div>
      )}
    </div>
  )}
  
  <div class="content">
    <header>
      <h2 class="title">
        {isClickable ? (
          <a href={item.link} class="title-link">
            {displayTitle}
          </a>
        ) : (
          displayTitle
        )}
      </h2>
      
      {displayExcerpt && (
        <p class="excerpt">{displayExcerpt}</p>
      )}
    </header>

    <div class="meta">
      {item.date && (
        <span class="meta-item">
          <Icon name="tabler:clock" class="meta-icon" />
          <time datetime={item.date}>{String(item.date).trim().replace(/\s+0$/, '')}</time>
        </span>
      )}
      
      {item.author && (
        <span class="meta-item">
          <Icon name="tabler:user" class="meta-icon" />
          <span>{item.author}</span>
        </span>
      )}
      
      {item.name && (contentType === 'excos' || contentType === 'house' || contentType === 'jc' || contentType === 'senators') && (
        <span class="meta-item">
          <Icon name="tabler:user" class="meta-icon" />
          <span>{item.name}</span>
        </span>
      )}
      

    </div>
  </div>
</article>

<style>
  .content-item {
    @apply bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 hover:border-gray-300 dark:hover:border-gray-600 transition-all duration-200 overflow-hidden;
  }
  
  .content-item.clickable:hover {
    @apply shadow-md;
  }
  
  .image-container {
    @apply relative overflow-hidden;
  }
  
  .image-wrapper {
    @apply relative overflow-hidden bg-gray-400 dark:bg-slate-700;
  }
  
  /* Portrait aspect ratio for excos/house/jc cards (4:5 ratio = 125%) */
  .image-wrapper.portrait {
    @apply pb-[125%];
  }
  
  /* Landscape aspect ratio for other content (16:9 ratio) */
  .image-wrapper.landscape {
    @apply pb-[56.25%];
  }
  
  .content-image {
    @apply absolute inset-0 w-full h-full;
  }
  
  /* For portrait images (excos/house/jc), prioritize showing faces at the top and ensure full coverage */
  .image-wrapper.portrait .content-image {
    @apply object-cover object-top;
    min-height: 100%;
    min-width: 100%;
  }
  
  /* For landscape images, use center positioning */
  .image-wrapper.landscape .content-image {
    @apply object-cover object-center;
  }
  
  .image-link:hover .content-image {
    @apply opacity-90 transition-opacity duration-200;
  }
  
  .content {
    @apply p-6;
  }
  
  .title {
    @apply text-xl sm:text-2xl font-bold leading-tight mb-2 font-heading dark:text-slate-300;
  }
  
  .title-link {
    @apply hover:text-gray-900 dark:hover:text-gray-100 transition-colors duration-200;
  }
  
  .excerpt {
    @apply text-gray-600 dark:text-gray-400 mb-4 line-clamp-2 leading-relaxed text-sm;
  }
  
  .meta {
    @apply flex flex-wrap items-center gap-3 text-sm text-gray-500 dark:text-gray-400;
  }
  
  .meta-item {
    @apply flex items-center gap-1;
  }
  
  .meta-icon {
    @apply w-3.5 h-3.5 inline-block -mt-0.5 dark:text-gray-400;
  }
  
  /* Layout-specific styles */
  .layout-cards .content {
    @apply p-4;
  }
  
  .layout-cards .title {
    @apply text-lg font-semibold;
  }
  
  .layout-cards .excerpt {
    @apply text-sm mb-3;
  }
  
  .layout-list .content-item {
    @apply flex flex-col md:flex-row gap-6;
  }
  
  .layout-list .image-container {
    @apply md:w-1/3;
  }
  
  .layout-list .content {
    @apply md:w-2/3;
  }
  
  /* Line clamp utility */
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  /* Responsive adjustments */
  @media (max-width: 640px) {
    .layout-list .content-item {
      @apply flex-col;
    }
    
    .layout-list .image-container {
      @apply w-full;
    }
    
    .layout-list .content {
      @apply w-full;
    }
  }
</style>
